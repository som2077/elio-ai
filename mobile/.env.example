# ==============================================================================
# ELIO AI MOBILE - CLIENT ENVIRONMENT CONFIGURATION
#
# SECURITY ARCHITECTURE GUARANTEES:
# 1. Thin-Client Model: NEVER place private server secrets, OpenAI API keys,
#    Supabase service_role keys, AI Gateway keys, or FCM server keys in this file.
# 2. All client builds (Expo/React Native) bundle public variables into the APK/IPA.
# 3. All sensitive logic, LLM prompting, and atomic quotas are strictly enforced on
#    the backend via Supabase Edge Functions and Security Definer RPCs.
# ==============================================================================

# Supabase Public Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Mixpanel Client Analytics
EXPO_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token-here
